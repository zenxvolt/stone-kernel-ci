# Opsional di Droidspaces: kalau gagal masuk ke .config, build tetap jalan dan
# hanya muncul peringatan.

# CFS_BANDWIDTH (untuk --cpus) sengaja tidak ada: di kernel ini ia bergantung pada
# !SCHED_WALT (init/Kconfig), sedangkan WALT adalah scheduler bawaan Qualcomm.
# Droidspaces hanya melewati batas --cpus dengan peringatan.

# --net=macvlan: container langsung di LAN kabel (mis. adaptor Ethernet USB OTG).
# Tidak berguna di Wi-Fi.
CONFIG_MACVLAN=y

# IPv6 + NAT66 untuk container mode NAT. Tanpa ini container hanya IPv4.
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
