# Opsi yang dibutuhkan systemd modern di kernel 5.4.
# Dipasangkan dengan patches/ (droidspaces-backports, seri 5.4).

# open_by_handle_at()/name_to_handle_at(): pelacakan mount dan unit systemd.
CONFIG_FHANDLE=y

# Socket AF_ALG untuk hash.
CONFIG_CRYPTO_USER_API_HASH=y

# autofs untuk unit automount. Di 5.4 namanya AUTOFS_FS (AUTOFS4_FS hanya alias).
CONFIG_AUTOFS_FS=y
