# Anland butuh DRM render node. Di stone node itu sudah disediakan driver display
# MSM (techpack/display, DRIVER_RENDER) dan GPU diakses lewat /dev/kgsl-3d0, jadi
# tidak perlu vgem dan tidak perlu patch seperti di rova. DRM sudah aktif di
# moonstone_defconfig; ditulis di sini supaya terverifikasi.
CONFIG_DRM=y
