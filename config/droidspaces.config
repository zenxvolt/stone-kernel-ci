# Droidspaces, GKI/QGKI-safe set (needs patches/droidspaces-kabi applied first).
# Source: Droidspaces-OSS Documentation/Kernel-Configuration.md, "GKI kernels".
# Baseline moonstone_defconfig has all of these OFF (checked with olddefconfig).
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
# docker "unsafe procfs" fix + "Allow Sandboxing"
CONFIG_USER_NS=y
# NixOS / systemd: xattr + ACL on tmpfs
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
# Already ON in the baseline; listed so the build fails loudly if a later change
# ever turns them off.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_TUN=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
# Deliberately NOT enabled (they resize scheduler/cgroup structs and break the
# kABI, see Droidspaces docs "CPU and process limits on GKI"):
#   CONFIG_CFS_BANDWIDTH, CONFIG_CGROUP_PIDS
