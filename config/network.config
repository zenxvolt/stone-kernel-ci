# macvlan mode (--net=macvlan) + IPv6 NAT (NAT66) for NAT-mode containers.
CONFIG_MACVLAN=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
# IPv6 base: already ON in the baseline, kept as a guard.
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
# USB-Ethernet (hub RJ45): RTL8152/8150, ASIX AX88179, CDC are already ON.
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
