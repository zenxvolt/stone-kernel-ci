# Droidspaces cgroup options missing from the dinosaur base config.
CONFIG_CGROUP_DEVICE=y
CONFIG_FAIR_GROUP_SCHED=y

# Left out on purpose:
#  - CFS_BANDWIDTH (cpu_limit): requested off; on this Qualcomm tree it also
#    depends on !SCHED_WALT.
#  - CGROUP_PIDS (pids_limit): requested off.
#  - CGROUP_NET_PRIO: does not compile on this tree
#    (include/net/netprio_cgroup.h: struct cgroup has no member 'id').
# CONFIG_CFS_BANDWIDTH is not set
# CONFIG_CGROUP_PIDS is not set
# CONFIG_CGROUP_NET_PRIO is not set
