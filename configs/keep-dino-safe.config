# Keep the settings that make the dinosaur kernel boot on stock HyperOS.
# Builds with LTO / CFI / Shadow Call Stack on did not boot on HyperOS
# (stuck at the POCO logo or bootloop), so they stay off.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_KPROBES is not set
# No vgem: a second DRM device can take /dev/dri/card0 from msm_drm.
# CONFIG_DRM_VGEM is not set

CONFIG_LOCALVERSION="-dino-bakasu"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
