# Droidspaces network options missing from the dinosaur base config.
# Covers the checks: bridge (full NAT), macvlan, ipv6_nat, and the
# UFW / Fail2Ban extras from Documentation/Kernel-Configuration.md.

# Full NAT (bridge + netfilter on the bridge)
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_TABLES=y

# --net=macvlan (only useful on wired LAN, e.g. USB Ethernet)
CONFIG_MACVLAN=y

# IPv6 NAT (NAT66)
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# UFW / Fail2Ban inside a container
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
