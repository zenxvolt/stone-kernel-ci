# Opsi tambahan untuk guest systemd modern (258-262).
# Sebagian besar kebutuhan systemd sudah ada di 5.4; yang diperlukan hanya
# backport VFS di patches/ plus opsi di bawah.

# open_by_handle_at()/name_to_handle_at(): pelacakan mount dan unit
CONFIG_FHANDLE=y

# Socket hash AF_ALG
CONFIG_CRYPTO_USER_API_HASH=y

# autofs: unit automount
CONFIG_AUTOFS_FS=y
