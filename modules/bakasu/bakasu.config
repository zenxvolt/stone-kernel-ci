# BakaSU - manual hook mode, tanpa SUSFS.
# Source stone (5.4.302) tidak membawa KernelSU bawaan, jadi tidak ada fragment
# ksu_* lain yang perlu dimatikan.
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_SUSFS is not set
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y

# BakaSU melewati cek "static symbol export" hanya bila KALLSYMS_ALL=y.
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
