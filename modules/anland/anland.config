# Anland (Wayland) di dalam container Droidspaces.
#
# KWin Anland butuh DRM render node (/dev/dri/renderD*). Di stone, driver msm
# (SDE) sudah mendaftarkan DRIVER_RENDER, dan vgem di 5.4 sudah membawa
# DRIVER_RENDER juga, jadi TIDAK ada patch kernel yang diperlukan (berbeda dari
# rova 4.19). vgem tetap diaktifkan sebagai node render virtual yang tidak
# bergantung pada driver display, sama seperti setup rova.
# Mesa memakai GPU lewat /dev/kgsl-3d0 (FD_FORCE_KGSL=1); node DRM hanya fd kontrol.
# Nomor node tergantung urutan probe: cek `ls -l /sys/class/drm` lalu atur
# ANLAND_DRM_DEVICE ke node yang kamu pilih.
CONFIG_DRM=y
CONFIG_DRM_VGEM=y

# Syscall kcmp, dipakai Mesa untuk membandingkan fd
# ("os_same_file_description ... Function not implemented").
CONFIG_CHECKPOINT_RESTORE=y
